# Set these in Vercel → Project → Settings → Environment Variables.
PLAYBOOK_PASSWORD=change-me
# Optional: extra secret mixed into the session cookie signature.
AUTH_SECRET=
# Optional: where "Was this page useful?" feedback is forwarded (JSON POST).
FEEDBACK_WEBHOOK_URL=
# Password for /admin/feedback (different from PLAYBOOK_PASSWORD).
ADMIN_PASSWORD=
# Added automatically when an Upstash Redis store is connected in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
