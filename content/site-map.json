  "dealRoom": {
    "scale": [
      "Unknown",
      "Partly supported",
      "Confirmed",
      "Tested through action"
    ],
    "dimensions": [
      {
        "name": "Need or pain",
        "question": "Do we know the pain or need, like fire, light or access to the plenum?",
        "verdicts": [
          "We are guessing what matters to them. Find out who can confirm the need.",
          "We have a view of the need, but the customer has not confirmed it. Confirm it with the person who owns it.",
          "The customer has confirmed the need. Note who confirmed it and when.",
          "The customer is acting on the need, for example through an evaluation or a decision. Keep it current."
        ]
      },
      {
        "name": "Right solution",
        "question": "Do we have a solution that fits the need well at a competitive price?",
        "verdicts": [
          "We cannot yet say why our offer fits or whether the price competes. Check the requirement first.",
          "We believe it fits, but technical or price checks are still open. Name what you have not yet checked.",
          "The customer agrees the solution fits the need at an acceptable price.",
          "A sample, test or evaluation has proven the fit. Protect the position."
        ]
      },
      {
        "name": "Access to power",
        "question": "Do we know the full decision-maker landscape, and do we have access to the decision makers?",
        "verdicts": [
          "We do not know who decides. Map who can approve, specify, influence or block.",
          "We know some of the decision makers, or reach them only through others. Find the missing support.",
          "We know the decision makers and have a credible route to each of them.",
          "We have met the relevant decision makers and they are involved in the next step."
        ]
      },
      {
        "name": "Decision process",
        "question": "Are we aware of the decision process they will go through, and the steps they will take?",
        "verdicts": [
          "We do not know how or when they will decide. Ask what happens next, and through whom.",
          "We have an idea of the steps, but we are assuming the timing or the responsibilities.",
          "The customer has confirmed the steps, the timing and who is responsible.",
          "A real milestone in their process has happened as agreed."
        ]
      },
      {
        "name": "Momentum",
        "question": "Do we have next steps planned, and is there clear momentum?",
        "verdicts": [
          "No recent progress and no agreed next step. Decide whether to re-engage or deprioritise.",
          "There is a next step, but the customer has not agreed the date or owner.",
          "The next step has an owner and a date the customer has agreed to.",
          "An agreed step was completed and the next commitment is in place."
        ]
      }
    ]
  },
